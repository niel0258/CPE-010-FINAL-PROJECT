//Quick Sort
template <typename T, typename Compare = std::less<T>>
void QuickSort(std::vector<T>& a, int low, int high, Compare cmp = Compare()) {
    if (low >= high) return; 
    T pivot = a[high]; 
    int i = low - 1; 
    for (int j = low; j < high; ++j)
        if (cmp(a[j], pivot)) std::swap(a[++i], a[j]);
    std::swap(a[i + 1], a[high]);
    QuickSort(a, low, i, cmp);
    QuickSort(a, i + 2, high, cmp);
}

//Binary Search
template <typename T, typename Compare = std::less<T>>
int binarySearch(const std::vector<T>& a, const T& target, Compare cmp = Compare()) {
    int low = 0, high = (int)a.size() - 1;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        if (cmp(a[mid], target))      low = mid + 1;
        else if (cmp(target, a[mid])) high = mid - 1;
        else return mid;
    }
    return -1;
}

struct Route {
    std::vector<int>stops; //rooms from start to destination
    int distance = 0;
};
//find all routes from current room to target
inline void DFSRoutes (const Graph& g, int current, int target, std::vector<int>& path, 
                        int distance,  std::vector<Route>& out) {
    path.push_back(current);
    if (current == target) {
        out.push_back(Route{path,distance}); // save the route if it reaches the target
    }  else {
        auto it = g.getAdjList().find(current);
        if (it != g.getAdjList().end())
            for (const auto& [next, w] : it->second) //next = neighbor, w = weight
                if (std::find(path.begin(), path.end(), next) == path.end()) //this avoid possible loops in the route
                    DFSRoutes(g, next, target, path, distance + w, out);
    }
    path.pop_back(); //backtrack
}

//Shortest route via Dijkstra
inline Route shortestRoute(const Graph& g, int src, int dst) {
    const auto& adj = g.getAdjList();
    std::map<int,int> dist, prev;
    using Item = std::pair<int,int>;
    std::priority_queue<Item, std::vector<Item>, std::greater<Item>> pq; //pops the closest vertex
    dist[src] = 0;
    pq.push({0, src});
    while (!pq.empty()){
        auto [d, u] = pq.top(); pq.pop();   //takes the closest unvisited room
        if (u == dst) break;
        if (d > dist [u]) continue;
        auto it = adj.find(u);
        if  (it == adj.end()) continue;
        for (const auto& [v,w] : it->second) { 
            int nd = d + w;
            if (!dist.count(v) || nd < dist[v]) { //checks if distance is the current best
                dist[v] = nd;
                prev[v] = u;        //tracks previous locations
                pq.push({nd,v});
            }
        }
    }
    Route r;
    if (!dist.count(dst)) return r; //no route exists
    for (int at = dst;; at = prev[at]) { //backtrack, destination to start
        r.stops.push_back(at);
        if (at == src) break;
    }
    std::reverse(r.stops.begin(), r.stops.end()); //flips so it becomes starts to destination
    r.distance = dist[dst];  //saves total distance                       
    return r;
}

inline std::mutex printMutex;  //lock so threads don't interfere with each other

//Changes Int to String so route can be printed as a string
inline std::string routeToString(const Route& r) {
    std::string s;
    for (size_t i = 0; i < r.stops.size(); ++i) {
        if (i) s += " -> ";
        s += std::to_string(r.stops[i]);
    }
    return s + " (" + std::to_string(r.distance) + " m)";
}

inline void findRoutes(const Graph& g, const std::vector<int>& sortedVertices, int from, int to) {
    std::string out = std::to_string(from) + " to " + std::to_string(to) + ":\n";
    if (binarySearch(sortedVertices, from) == -1 || binarySearch(sortedVertices, to) == -1) {  //Checks if both current location and destination exists
        out += "  place does not exist\n";
    } else {
        std::vector<Route> all;
        std::vector<int> path; 
        DFSRoutes(g, from, to, path, 0, all);    //collects all possible routes
        QuickSort(all, 0, (int)all.size() - 1,   //shortest distance first
                  [](const Route& a, const Route& b) { return a.distance < b.distance; });
        for (size_t i = 0; i < all.size(); ++i)
            out += "  Route " + std::to_string(i + 1) + ": " + routeToString(all[i]) + "\n";
        out += "  Best (Dijkstra): " + routeToString(shortestRoute(g, from, to)) + "\n";
    }
    std::lock_guard<std::mutex> lock(printMutex);  //manages one threads at a time
    std::cout << out;
}
#endif
